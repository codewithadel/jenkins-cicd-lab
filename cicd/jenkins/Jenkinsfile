
pipeline {
    agent {
        label 'docker-agent'
    }

    options {
        timestamps()
        disableConcurrentBuilds()
        skipDefaultCheckout(true)
    }

    stages {
        stage('Checkout SCM') {
            steps {
                checkout scm
            }
        }

        stage('Validate Environment') {
            steps {
                sh '''
                    echo "Running on:"
                    hostname

                    echo "Java version:"
                    java -version

                    echo "Git version:"
                    git --version

                    echo "Maven Wrapper:"
                    cd app
                    sh ./mvnw -version
                '''
            }
        }

        stage('Build and Test') {
            steps {
                dir('app') {
                    sh '''
                        chmod +x ./mvnw
                        ./mvnw -B -ntp clean verify \
                           -Dmaven.wagon.http.retryHandler.count=3
                    '''
                }
            }
        }

        stage('SonarQube Integration Test') {
            steps {
                echo 'STEP 1: Before SonarQube wrapper'

                withSonarQubeEnv('Sonarqube') {
                    echo 'STEP 2: SonarQube environment loaded'
                    sh 'echo "SONAR_HOST_URL=$SONAR_HOST_URL"'
                }

                echo 'STEP 3: Integration completed'
            }
        }

        stage('SonarQube Analysis') {
            steps {
                dir('app') {
                    withSonarQubeEnv('Sonarqube') {
                        sh '''
                            chmod +x ./mvnw
                            ./mvnw -B -ntp sonar:sonar \
                              -Dsonar.projectKey=product-api \
                              -Dsonar.projectName=product-api
                        '''
                    }
                }
            }
        }

        stage('Quality Gate') {
            steps {
                timeout(time: 5, unit: 'MINUTES') {
                    waitForQualityGate abortPipeline: true
                }
            }
        }

        stage('Archive Artifact') {
            steps {
                archiveArtifacts(
                    artifacts: 'app/target/*.jar',
                    fingerprint: true
                )
            }
        }
    }

    post {
        success {
            echo 'Spring Boot CI build completed successfully.'
        }

        failure {
            echo 'Pipeline failed. Check console output.'
        }
    }
}