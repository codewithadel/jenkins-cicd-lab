
pipeline {
    agent {
        label 'docker-agent'
    }

    options {
        timestamps()
        disableConcurrentBuilds()
        skipDefaultCheckout(true)
    }

    stages {
        stage('Checkout SCM') {
            steps {
                checkout scm
            }
        }

        stage('Validate Environment') {
            steps {
                sh '''
                    echo "Running on:"
                    hostname

                    echo "Java version:"
                    java -version

                    echo "Git version:"
                    git --version

                    echo "Maven Wrapper:"
                    cd app
                    sh ./mvnw -version
                '''
            }
        }

        stage('Build and Test') {
            steps {
                dir('app') {
                    sh '''
                        chmod +x ./mvnw
                        ./mvnw -B -ntp clean verify \
                           -Dmaven.wagon.http.retryHandler.count=3'sh ./mvnw clean verify'
                    '''
                }
            }
        }

        stage('Archive Artifact') {
            steps {
                archiveArtifacts(
                    artifacts: 'app/target/*.jar',
                    fingerprint: true
                )
            }
        }
    }

    post {
        success {
            echo 'Spring Boot CI build completed successfully.'
        }

        failure {
            echo 'Pipeline failed. Check console output.'
        }
    }
}