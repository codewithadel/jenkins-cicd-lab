
pipeline {
    agent {
        label 'docker-agent'
    }

    options {
        timestamps()
        disableConcurrentBuilds()
        skipDefaultCheckout(true)
    }

    stages {
        stage('Checkout SCM') {
            steps {
                checkout scm
            }
        }

        stage('Validate Environment') {
            steps {
                sh '''
                    echo "Running on:"
                    hostname

                    echo "Java version:"
                    java -version

                    echo "Git version:"
                    git --version

                    echo "Maven Wrapper:"
                    cd app
                    sh ./mvnw -version
                '''
            }
        }

        stage('Build and Test') {
            steps {
                dir('app') {
                    sh 'sh ./mvnw clean verify'
                }
            }
        }

        stage('Archive Artifact') {
            steps {
                archiveArtifacts(
                    artifacts: 'app/target/*.jar',
                    fingerprint: true
                )
            }
        }
    }

    post {
        success {
            echo 'Spring Boot CI build completed successfully.'
        }

        failure {
            echo 'Pipeline failed. Check console output.'
        }
    }
}

#If using docker agent disregard the below configuration steps commented out.

#Understanding the pipeline stages
#Stage:heckout SCM -> Pulls the latest code from GitHub
#Validate Build Environment -> Pulls the latest code from GitHub
#Checks Java and Maven Wrapper availability
#Build and Test	Compiles the application, executes tests, and packages the JAR
#Archive JAR	Saves the build artifact in Jenkins for future reference

#####Important:#####
# Jenkins must have Java 21 installed on the agent executing this pipeline. Java installed on your Mac is not automatically available to Jenkins if Jenkins runs inside Docker.